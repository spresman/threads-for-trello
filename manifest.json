{
  "manifest_version": 3,
  "name": "Threads for Trello",
  "version": "0.1.2",
  "description": "Collapsible threaded replies on Trello cards, built on native Trello comments.",
  "permissions": ["storage"],
  "host_permissions": ["https://trello.com/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Threads for Trello",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://trello.com/*"],
      "js": ["src/interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://trello.com/*"],
      "js": ["src/threads.js"],
      "css": ["src/threads.css"],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    }
  ]
}
